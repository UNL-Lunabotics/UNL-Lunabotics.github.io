{
  "version": "0.2",
  "ignorePaths": [
    "vendor/**",
    "node_modules/**",
    "**/_*.md"
  ],
  "languageSettings": [
    {
      "languageId": "markdown",
      "patterns": [
        {
          "name": "markdown-fenced-code",
          "pattern": "/^\\s*```[\\s\\S]*?^\\s*```/gm"
        },
        {
          "name": "markdown-inline-code",
          "pattern": "/`([^`\\r\\n]+?)`/g"
        }
      ],
      "ignoreRegExpList": [
        "markdown-fenced-code",
        "markdown-inline-code"
      ]
    }
  ],
