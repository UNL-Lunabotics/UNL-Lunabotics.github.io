{
  "markdownlint.customRules": [
    "./.vscode/markdownlint-rules/require-author-tag.js"
  ],
  "cSpell.languageSettings": [
    {
      "languageId": "markdown",
      "patterns": [
        {
          "name": "MarkdownCodeBlock",
          "pattern": "/^\\s*```[\\s\\S]*?^\\s*```/gm"
        },
        {
          "name": "MarkdownInlineCode",
          "pattern": "/`([^`\\r\\n]+?)`/g"
        }
      ],
      "ignoreRegExpList": [
        "MarkdownCodeBlock",
        "MarkdownInlineCode"
      ]
    }
  ],
